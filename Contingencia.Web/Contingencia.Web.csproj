<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Contingencia.Application\Contingencia.Application.csproj" />
    <ProjectReference Include="..\Contingencia.Domain\Contingencia.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Development.json trae la cadena de conexión de pruebas, la clave del correo y la clave secreta de Turnstile de desarrollo:
         no debe viajar a producción en la publicación (allá la configuración va por variables de entorno). -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>9bd49ffc-601a-43d3-8245-552755916cf9</UserSecretsId>
  </PropertyGroup>

</Project>
