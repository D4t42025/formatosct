@page "/login"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using Contingencia.Application.Login
@using Contingencia.Web.Services
@inject ILoginService LoginService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ILegacyUrlBuilder LegacyUrlBuilder

<PageTitle>IMPERIUM - Login</PageTitle>

@* Diseño nuevo (login-v2) migrado de Login3.aspx: el marco (fondo, contacto, panel) vive en Layout/LoginLayout.razor. La lógica del servidor no cambió. *@

<h2 hidden="@mostrarFormularioRecuperar">Bienvenido de nuevo</h2>
<p class="lead" hidden="@mostrarFormularioRecuperar">Ingrese con su usuario y contraseña.</p>

<EditForm Model="Input" FormName="login" OnValidSubmit="ManejarLoginAsync" method="post" data-enhance="false" id="FORM1" novalidate hidden="@mostrarFormularioRecuperar">
    <DataAnnotationsValidator />
    @if (mensaje is not null && !mostrarFormularioRecuperar)
    {
        <p class="form-msg @(mensajeEsError ? "err" : "ok") show" role="alert">@mensaje</p>
    }
    <div class="field">
        <label for="txtusuario">Usuario</label>
        <div class="control">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0"/></svg>
            <InputText id="txtusuario" type="text" @bind-Value="Input.Usuario" data-role="usuario" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="Ingrese su usuario" />
        </div>
        <p class="msg" data-for="usuario" role="alert"></p>
        <ValidationMessage For="() => Input.Usuario" />
    </div>
    <div class="field">
        <label for="txtclave">Contraseña</label>
        <div class="control">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            <InputText id="txtclave" type="password" @bind-Value="Input.Clave" data-role="clave" autocomplete="current-password" placeholder="Ingrese su contraseña" />
            <button class="toggle" type="button" aria-label="Mostrar contraseña" aria-pressed="false"><svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 6.1A9.8 9.8 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.2 3.8M6.5 7.6A17 17 0 0 0 2 12s3.6 7 10 7a9.8 9.8 0 0 0 4-.9M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button>
        </div>
        <p class="hint" id="caps">Tiene activado el bloqueo de mayúsculas.</p>
        <p class="msg" data-for="clave" role="alert"></p>
        <ValidationMessage For="() => Input.Clave" />
    </div>
    <div class="captcha-slot">
        <div id="turnstile-container" data-sitekey="@SiteKey" data-permanent></div>
    </div>
    <a href="javascript:void(0)" id="to-recover" class="forgot"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>¿Olvidó su clave?</a>
    <button class="submit" id="btnlogin2" type="submit"><span class="go-t">Iniciar sesión</span><i class="bar"></i></button>
</EditForm>

<EditForm Model="RecuperarInput" FormName="recuperar" OnValidSubmit="ManejarRecuperarAsync" method="post" data-enhance="false" id="recoverform" class="recover" novalidate hidden="@(!mostrarFormularioRecuperar)">
    <DataAnnotationsValidator />
    <h3>Recuperar contraseña</h3>
    <p class="sub">Ingresa tu email y espera un correo con las instrucciones.</p>
    @if (mensaje is not null && mostrarFormularioRecuperar)
    {
        <p class="form-msg @(mensajeEsError ? "err" : "ok") show" role="alert">@mensaje</p>
    }
    <div class="field">
        <label for="txtemail">Correo electrónico</label>
        <div class="control">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7.5 8.5 6 8.5-6"/></svg>
            <InputText id="txtemail" @bind-Value="RecuperarInput.Email" type="text" autocomplete="email" placeholder="Email" />
        </div>
        <ValidationMessage For="() => RecuperarInput.Email" />
    </div>
    <button class="submit" id="btnolvidopwd" type="submit"><span class="go-t">Recordar</span><i class="bar"></i></button>
    <div class="back"><a href="javascript:void(0)" id="back-to-login"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg>Volver a iniciar sesión</a></div>
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private LoginInputModel? Input { get; set; }

    [SupplyParameterFromForm(FormName = "recuperar")]
    private RecuperarInputModel? RecuperarInput { get; set; }

    [SupplyParameterFromForm(Name = "cf-turnstile-response", FormName = "login")]
    private string? CaptchaResponse { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? mensaje;
    private bool mensajeEsError;

    // Igual que en el Login.razor de Recobros: ambos formularios envían con
    // data-enhance="false" (recarga completa), así que el toggle JS se pierde en cada
    // recarga. Este flag decide, del lado del servidor, cuál formulario queda visible en el
    // primer pintado después de un postback de "recuperar".
    private bool mostrarFormularioRecuperar;

    private string SiteKey => Configuration["Turnstile:SiteKey"] ?? "";
    
    protected override void OnInitialized()
    {
        Input ??= new LoginInputModel();
        RecuperarInput ??= new RecuperarInputModel();
    }

    private async Task ManejarLoginAsync()
    {
        var ip = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "";
        var resultado = await LoginService.IniciarSesionAsync(Input!.Usuario, Input.Clave, CaptchaResponse ?? "", ip);

        if (resultado.Estado != EstadoIntentoLogin.Exito)
        {
            mensaje = resultado.Mensaje;
            mensajeEsError = true;
            return;
        }

        HttpContext.Response.Cookies.Append("ImperiumBridge", resultado.TokenPuente!.Value.ToString("N"), new CookieOptions
        {
            HttpOnly = true,
            Secure = HttpContext.Request.IsHttps,
            SameSite = SameSiteMode.Lax,
            Expires = DateTimeOffset.UtcNow.AddMinutes(10),
        });

        var destino = resultado.UrlDestino!.StartsWith('/')
            ? resultado.UrlDestino!
            : LegacyUrlBuilder.Url(resultado.UrlDestino!);

        Navigation.NavigateTo(destino, forceLoad: true);
    }

    private async Task ManejarRecuperarAsync()
    {
        mostrarFormularioRecuperar = true;

        // Réplica de crearcorreo() en Login3.aspx.vb: el envío va en Try/Catch y muestra un
        // mensaje distinto si el SMTP falla, en vez de reportar éxito sin importar el resultado.
        try
        {
            await LoginService.EnviarClaveTemporalAsync(RecuperarInput!.Email);
            mensaje = "Mensaje enviado. Revise su correo para continuar.";
            mensajeEsError = false;
        }
        catch
        {
            mensaje = "El mensaje no fue posible enviarlo. Intente nuevamente.";
            mensajeEsError = true;
        }
    }

    private class LoginInputModel
    {
        [Required(ErrorMessage = "Ingrese el usuario")]
        public string Usuario { get; set; } = "";

        [Required(ErrorMessage = "Ingrese la contraseña")]
        public string Clave { get; set; } = "";
    }

    private class RecuperarInputModel
    {
        [Required, EmailAddress(ErrorMessage = "Ingrese un correo válido")]
        public string Email { get; set; } = "";
    }
}
