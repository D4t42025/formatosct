    private async Task PasoSiguienteAsync()
    {
        var error = ValidarPasoActual();
        if (error is not null)
        {
            mensaje = error;
            await JS.InvokeVoidAsync("Tran", error, "");
            return;
        }

        mensaje = null;
        await DetenerDictadoSiActivoAsync();
        LimpiarEstadoDictado();
        pasoActual++;

        if (pasoActual == 10)
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("ImperiumFirmaCanvas.iniciar", "nc-canvas-firma");
        }
    }

    private string? ValidarPasoActual() => ValidarPaso(pasoActual);

    // Paso 4 en modo manual (CIA sin web service de afiliados): el formulario reemplaza la
    // consulta, así que los datos mínimos del paciente se exigen aquí.
    private string? ValidarPacienteManual()
    {
        if (string.IsNullOrWhiteSpace(form.PacienteNumDoc)) return "Debe ingresar el número de documento del paciente.";
        if (!form.PacienteNumDoc.Trim().All(char.IsLetterOrDigit)) return "El número de documento solo puede tener letras y números.";
        if (string.IsNullOrWhiteSpace(form.PacienteNombres)) return "Debe ingresar los nombres del paciente.";
        if (string.IsNullOrWhiteSpace(form.PacienteApellidos)) return "Debe ingresar los apellidos del paciente.";
        if (string.IsNullOrWhiteSpace(form.PacienteSexo)) return "Debe seleccionar el sexo del paciente.";
        if (!DateTime.TryParse(form.PacienteFechaNacimiento, out var nacimiento)) return "Debe ingresar la fecha de nacimiento del paciente.";
        if (nacimiento.Date > DateTime.Today) return "La fecha de nacimiento no puede ser futura.";
        if (string.IsNullOrWhiteSpace(form.FechaAtencion) || string.IsNullOrWhiteSpace(form.HoraAtencion)) return "Debe ingresar la fecha y hora de atención.";
        if (string.IsNullOrWhiteSpace(form.AmbitoAtencionCodigo)) return "Debe seleccionar el ámbito de atención.";
        return null;
    }

    private string? ValidarPaso(int paso) => paso switch
    {
        1 => string.IsNullOrWhiteSpace(form.Causal) ? "Debe seleccionar la causal de la contingencia."
             : string.IsNullOrWhiteSpace(form.CausalDescripcion) ? "Debe ingresar la descripción de la contingencia."
             : null,
        2 => string.IsNullOrWhiteSpace(form.IpsTexto) ? "Debe ingresar la IPS."
             : detalleIps is null ? "Debe elegir la IPS de la lista de sugerencias (no se admite texto libre)."
             : null,
        3 => string.IsNullOrWhiteSpace(form.ProfesionalTexto) ? "Debe ingresar el profesional tratante."
             : detalleProfesional is null ? "Debe elegir el profesional de la lista de sugerencias (no se admite texto libre)."
             : null,
        4 => AfiliadosManual ? ValidarPacienteManual()
             : !afiliadoEncontrado ? "Debe buscar y confirmar el paciente."
             : string.IsNullOrWhiteSpace(form.FechaAtencion) || string.IsNullOrWhiteSpace(form.HoraAtencion)
                ? "Debe ingresar la fecha y hora de atención."
             : string.IsNullOrWhiteSpace(form.AmbitoAtencionCodigo) ? "Debe seleccionar el ámbito de atención."
             : null,
        5 => string.IsNullOrWhiteSpace(form.DiagnosticoTexto) ? "Debe ingresar el diagnóstico (CIE-10)."
             : detalleDiagnostico is null ? "Debe elegir el diagnóstico de la lista de sugerencias (no se admite texto libre)."
             : !string.IsNullOrWhiteSpace(form.DiagnosticoRel1Texto) && detalleDiagnosticoRel1 is null
                ? "El diagnóstico relacionado 1 debe elegirse de la lista de sugerencias (no se admite texto libre)."
             : !string.IsNullOrWhiteSpace(form.DiagnosticoRel2Texto) && detalleDiagnosticoRel2 is null
                ? "El diagnóstico relacionado 2 debe elegirse de la lista de sugerencias (no se admite texto libre)."
             : null,
        6 => string.IsNullOrWhiteSpace(form.TipoTecnologia) ? "Debe seleccionar el tipo de tecnología." : null,
        7 => form.TipoTecnologia is "Procedimiento" or "Dispositivo" or "ProductoNutricional" or "ServicioComplementario"
                && (string.IsNullOrWhiteSpace(form.TecBusquedaTexto) || detalleCodigoTecnologia is null)
             ? "Debe elegir el código de la lista de sugerencias (no se admite texto libre)."
             : form.TipoTecnologia == "Medicamento" && (string.IsNullOrWhiteSpace(form.TecPrincipioActivo) || !principioActivoValido)
             ? "Debe elegir el principio activo (DCI) de la lista de sugerencias (no se admite texto libre)."
             : form.TipoTecnologia == "Medicamento" && (
                    string.IsNullOrWhiteSpace(form.TecDosis) || string.IsNullOrWhiteSpace(form.TecFormaFarmaceutica)
                    || string.IsNullOrWhiteSpace(form.TecViaAdministracion))
             ? "Debe completar concentración, forma farmacéutica y vía de administración."
             : null,
        8 => form.TipoTecnologia == "Medicamento"
                ? string.IsNullOrWhiteSpace(form.PosCantidadFormulada) ? "Debe ingresar la dosis."
                : string.IsNullOrWhiteSpace(form.PosCadaFrecuencia) ? "Debe ingresar la frecuencia."
                : string.IsNullOrWhiteSpace(form.PosCantidadTotal) ? "Debe ingresar la cantidad total."
                : null
             : string.IsNullOrWhiteSpace(form.PosCantidadTotal)
             ? "Debe ingresar la cantidad total."
             : null,
        9 => string.IsNullOrWhiteSpace(form.JustificacionTecnica) ? "Debe ingresar la justificación técnica." : null,
        _ => null,
    };

    private Task CambiarADibujoAsync() => CambiarModoFirmaAsync("dibujo");

