    private async Task CambiarModoFirmaAsync(string modo)
    {
        modoFirma = modo;
        StateHasChanged();
        if (modo == "dibujo")
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("ImperiumFirmaCanvas.iniciar", "nc-canvas-firma");
        }
    }

    private async Task LimpiarDibujoAsync() => await JS.InvokeVoidAsync("ImperiumFirmaCanvas.limpiar", "nc-canvas-firma");

    private async Task GuardarDibujoAsync()
    {
        var tieneTrazo = await JS.InvokeAsync<bool>("ImperiumFirmaCanvas.tieneTrazo", "nc-canvas-firma");
        if (!tieneTrazo)
        {
            mensaje = "Dibuje la firma antes de guardarla.";
            return;
        }

        firmaDataUrl = await JS.InvokeAsync<string>("ImperiumFirmaCanvas.exportarPng", "nc-canvas-firma");
        firmaArchivoBytes = null;
        firmaArchivoExtension = null;
        mensaje = null;
    }

    private async Task OnArchivoFirmaSeleccionadoAsync(InputFileChangeEventArgs e)
    {
        firmaArchivoExtension = Path.GetExtension(e.File.Name).ToLowerInvariant();
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);
        firmaArchivoBytes = memoria.ToArray();
        firmaDataUrl = firmaArchivoExtension is ".png" or ".jpg" or ".jpeg"
            ? $"data:image/{(firmaArchivoExtension == ".png" ? "png" : "jpeg")};base64,{Convert.ToBase64String(firmaArchivoBytes)}"
            : null;
    }

    private async Task OnSoportesSeleccionadosAsync(InputFileChangeEventArgs e)
    {
        soportes.Clear();
        foreach (var archivo in e.GetMultipleFiles(10))
        {
            var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
            if (!ExtensionesSoportesPermitidas.Contains(extension)) continue;

            await using var stream = archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            soportes.Add((archivo.Name, memoria.ToArray()));
        }
    }

    private async Task ConfirmarAsync()
    {
        var tieneFirma = firmaDataUrl is not null || firmaArchivoBytes is not null;
        if (!tieneFirma)
        {
            mensaje = "Debe capturar la firma antes de confirmar.";
            await JS.InvokeVoidAsync("Tran", mensaje, "");
            return;
        }

        enviando = true;
        try
        {
            await DetenerDictadoSiActivoAsync();
            var (cia, usuApp) = await ObtenerUsuarioAsync();

            var causalNombre = parametricas["CAUSAL"].FirstOrDefault(c => c.Codigo == form.Causal)?.Valor;
            var (ipsCodigo, ipsNombre) = PartirEnDos(form.IpsTexto);
            var (profesionalDocumento, resto) = PartirEnDos(form.ProfesionalTexto);
            var (profesionalNombre, profesionalProfesion) = PartirEnDos(resto ?? "");
            var (diagnosticoCodigo, diagnosticoDescripcion) = PartirEnDos(form.DiagnosticoTexto);
            var (diagnosticoRel1Codigo, diagnosticoRel1Descripcion) = PartirEnDos(form.DiagnosticoRel1Texto);
            var (diagnosticoRel2Codigo, diagnosticoRel2Descripcion) = PartirEnDos(form.DiagnosticoRel2Texto);

            DateTime? fechaNacimiento = DateTime.TryParse(form.PacienteFechaNacimiento, out var fn) ? fn : null;
            DateTime? fechaAtencion = DateTime.TryParse(form.FechaAtencion, out var fa) ? fa : null;
            var ambitoAtencionNombre = ambitosAtencion.FirstOrDefault(a => a.Codigo == form.AmbitoAtencionCodigo).Descripcion;

            var solicitud = new SolicitudNuevaContingencia(
                form.Causal.Trim(), causalNombre, NuloSiVacio(form.CausalDescripcion),
                ipsCodigo, ipsNombre,
                profesionalDocumento ?? "", profesionalNombre, profesionalProfesion,
                form.PacienteTipoDoc, form.PacienteNumDoc.Trim(), form.PacienteNombres.Trim(), form.PacienteApellidos.Trim(),
                string.IsNullOrEmpty(form.PacienteSexo) ? null : form.PacienteSexo,
                fechaNacimiento,
                string.IsNullOrEmpty(form.PacienteMunicipio) ? null : form.PacienteMunicipio,
                string.IsNullOrEmpty(form.PacienteTelefono) ? null : form.PacienteTelefono,
                string.IsNullOrEmpty(form.PacienteRegimen) ? null : form.PacienteRegimen,
                fechaAtencion, NuloSiVacio(form.HoraAtencion),
                NuloSiVacio(form.AmbitoAtencionCodigo), NuloSiVacio(ambitoAtencionNombre),
                diagnosticoCodigo ?? "", diagnosticoDescripcion,
                diagnosticoRel1Codigo, diagnosticoRel1Descripcion, diagnosticoRel2Codigo, diagnosticoRel2Descripcion,
                TodasLasTecnologias());

            var resultado = await ContingenciasService.RegistrarAsync(cia, usuApp, solicitud);
            if (!resultado.Exito)
            {
                mensaje = resultado.Mensaje;
                await JS.InvokeVoidAsync("Tran", resultado.Mensaje, "");
                return;
            }

            var radicado = resultado.Radicado!;

            string? firmaRutaRelativa = null;
            if (firmaArchivoBytes is not null)
            {
                firmaRutaRelativa = ArchivoService.RutaRelativaFirma(cia, radicado);
                using var stream = new MemoryStream(firmaArchivoBytes);
                await ArchivoService.GuardarAsync(firmaRutaRelativa, stream);
            }
            else if (firmaDataUrl is not null)
            {
                firmaRutaRelativa = ArchivoService.RutaRelativaFirma(cia, radicado);
                await ArchivoService.GuardarBase64PngAsync(firmaRutaRelativa, firmaDataUrl);
            }

            var rutasSoportes = new List<string>();
            for (var i = 0; i < soportes.Count; i++)
            {
                var extension = Path.GetExtension(soportes[i].NombreOriginal).ToLowerInvariant();
                var rutaRelativa = ArchivoService.RutaRelativaSoporte(cia, radicado, i + 1, extension);
                using var stream = new MemoryStream(soportes[i].Contenido);
                await ArchivoService.GuardarAsync(rutaRelativa, stream);
                rutasSoportes.Add(rutaRelativa);
            }

            var soportesJson = rutasSoportes.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(rutasSoportes) : null;
            await ContingenciasService.ActualizarArchivosAsync(cia, radicado, firmaRutaRelativa, soportesJson);

            await JS.InvokeVoidAsync("TranFormulario", "Contingencia registrada", $"Radicado: {radicado}",
                $"/api/contingencias/formulario?radicado={Uri.EscapeDataString(radicado)}", "/formatos/contingencias/consultar");
        }
        finally
        {
            enviando = false;
        }
    }

    // Datalist arma "Parte1|Parte2" (mismo formato que "Codigo|Nombre" ya usado por el
    // autocompletado de prestador) — si el usuario escribe texto libre sin elegir una
    // sugerencia, se guarda todo en Parte1 y Parte2 queda null (misma tolerancia que
    // CargarFormato.razor con el campo de prestador).
    private static (string? Parte1, string? Parte2) PartirEnDos(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return (null, null);
        var indice = texto.IndexOf('|');
        return indice < 0 ? (texto.Trim(), null) : (texto[..indice].Trim(), texto[(indice + 1)..].Trim());
    }

    // Para la revisión final (paso 11): convierte "Codigo|Descripcion" en "Codigo — Descripcion"
    // en vez de mostrarle al usuario el separador interno crudo del datalist.
    private static string TextoLegible(string texto)
    {
        var (parte1, parte2) = PartirEnDos(texto);
        if (parte1 is null) return "";
        return parte2 is null ? parte1 : $"{parte1} — {parte2}";
    }

    private string ProfesionalLegible()
    {
        var (documento, resto) = PartirEnDos(form.ProfesionalTexto);
        if (documento is null) return "";
        var (nombre, profesion) = PartirEnDos(resto ?? "");
        if (nombre is null) return documento;
        return profesion is null ? $"{documento} — {nombre}" : $"{documento} — {nombre} ({profesion})";
    }

    private static string? NuloSiVacio(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor;

    // ================= Dictado por voz =================

    private async Task AlternarDictadoAsync()
    {
        if (dictando)
        {
            await JS.InvokeVoidAsync("ImperiumDictado.detener");
            dictando = false;
            return;
        }

        errorDictado = null;
        dictadoRef ??= DotNetObjectReference.Create(this);
        dictando = true;
        await JS.InvokeVoidAsync("ImperiumDictado.iniciar", dictadoRef, "es-CO");
    }

    private async Task DetenerDictadoSiActivoAsync()
    {
        if (!dictando) return;
        await JS.InvokeVoidAsync("ImperiumDictado.detener");
        dictando = false;
    }

    private void LimpiarEstadoDictado()
    {
        transcripcionDictado = "";
        errorDictado = null;
        mensajeDictado = null;
    }

    private void LimpiarDictado()
    {
        transcripcionDictado = "";
        mensajeDictado = null;
    }

    [JSInvokable]
    public void OnDictadoResultado(string transcripcion, bool esFinal)
    {
        if (!esFinal) return;
        transcripcionDictado = string.IsNullOrWhiteSpace(transcripcionDictado)
            ? transcripcion.Trim()
            : $"{transcripcionDictado} {transcripcion.Trim()}";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDictadoError(string codigo)
    {
        dictando = false;
        errorDictado = codigo switch
        {
            "not-allowed" or "service-not-allowed" => "Permiso de micrófono denegado. Habilítalo en el navegador.",
            "no-speech" => "No se detectó voz. Intenta de nuevo.",
            "audio-capture" => "No se encontró un micrófono disponible.",
            "no-soportado" => "Dictado por voz no disponible en este navegador.",
            _ => $"No se pudo usar el dictado por voz ({codigo}).",
        };
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDictadoFin()
    {
        dictando = false;
        StateHasChanged();
    }

