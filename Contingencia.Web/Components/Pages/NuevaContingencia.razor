    private async Task OnTecBusquedaInputAsync(ChangeEventArgs e)
    {
        form.TecBusquedaTexto = e.Value?.ToString() ?? "";
        var tipoServicio = TipoServicioParaBusqueda();

        // El datalist arma el valor como "Codigo|Descripcion" — si tiene esa forma, ya se
        // eligió una opción; se busca por el código para confirmar que existe realmente en
        // DQS_MIP_CODIGOS (no se admite texto libre, mismo criterio de IPS/Profesional/
        // Diagnóstico) y para volcar Código/Descripción a los campos reales del formulario.
        var indice = form.TecBusquedaTexto.IndexOf('|');
        if (indice > 0)
        {
            var codigo = form.TecBusquedaTexto[..indice].Trim();
            opcionesCodigosTecnologia = [];
            var encontrados = await CodigosService.BuscarAsync(parametrosCia.CodigosCatalogo, tipoServicio, codigo);
            detalleCodigoTecnologia = encontrados.FirstOrDefault(c => c.Codigo == codigo);
            form.TecCodigo = detalleCodigoTecnologia?.Codigo ?? "";
            form.TecNombre = detalleCodigoTecnologia?.Descripcion ?? "";
        }
        else
        {
            detalleCodigoTecnologia = null;
            form.TecCodigo = "";
            form.TecNombre = "";
            opcionesCodigosTecnologia = await CodigosService.BuscarAsync(parametrosCia.CodigosCatalogo, tipoServicio, form.TecBusquedaTexto);
        }
    }

    // DQS_MIP_DCI no tiene código (son denominaciones DCI) — a diferencia de los demás
    // campos de búsqueda, acá no hay forma "Codigo|Descripcion" que detectar; se verifica
