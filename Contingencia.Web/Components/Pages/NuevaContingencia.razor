@page "/formatos/contingencias/nueva"
@layout AppLayout
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using System.Data
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Contingencia.Application.Auth
@using Contingencia.Application.Formatos
@using Contingencia.Application.Profesionales
@using Contingencia.Application.Cie10
@using Contingencia.Application.Codigos
@using Contingencia.Application.Dci
@using Contingencia.Application.Contingencias
@using Contingencia.Application.Parametricas
@using Contingencia.Application.Afiliados
@using Contingencia.Application.CiaParametros
@using Contingencia.Infrastructure.Cie10
@using Contingencia.Infrastructure.Codigos
@using Contingencia.Infrastructure.Profesionales
@using Contingencia.Infrastructure.Filtros
@using Contingencia.Web.Services
@inject IFormatosService FormatosService
@inject IProfesionalesService ProfesionalesService
@inject ICie10Service Cie10Service
@inject ICodigosService CodigosService
@inject IDciService DciService
@inject IParametricasService ParametricasService
@inject IAfiliadoService AfiliadoService
@inject ICiaParametrosService CiaParametrosService
@inject IFiltrosRepository FiltrosRepository
@inject IContingenciasService ContingenciasService
@inject IContingenciaArchivoService ArchivoService
@inject IJSRuntime JS
@inject NavigationManager NavManager

@* Wizard de 11 pasos "Nueva Contingencia MIPRES", inspirado en el prototipo externo
   mipres-flow-buddy.lovable.app/nueva-contingencia. No es una migración de una pantalla
   legada (no existe ningún equivalente en el WebForms original) — es una funcionalidad
   nueva que registra una contingencia con datos estructurados, en vez de solo cargar un PDF
   ya diligenciado (eso es lo que hace "Cargar formato"/CargarFormato.razor).

   La firma capturada acá (dibujo en canvas o archivo, mismo patrón que Profesionales.razor)
   es un PLACEHOLDER local: no integra ningún proveedor real de firma electrónica avanzada
   (FEA) — ver el aviso fijo en el paso 10 y la columna FIRMAPENDIENTEFEA (siempre 1) en
   BASE_DE_DATOS.md.

   El dictado por voz (pasos 1-9) usa la Web Speech API del navegador (100% del lado del
   cliente, ver dictado-voz.js) — requiere Chrome/Edge y contexto seguro (HTTPS o
   localhost); si el navegador no la soporta, el bloque se muestra deshabilitado con un
   aviso. El reconocimiento de campo+valor es "mejor esfuerzo" (busca el sinónimo de campo
   más largo mencionado en la frase y toma lo que sigue como el valor, con fuzzy-match
   contra catálogos cerrados) — nunca bloquea el flujo: lo que no se reconoce se deja para
   llenar a mano. Ver BASE_DE_DATOS.md, "Página 11", para el detalle completo. *@

<PageTitle>Nueva contingencia MIPRES</PageTitle>

<div class="fmt-header">
    <h1><i class="fa-solid fa-triangle-exclamation"></i> Nueva contingencia MIPRES</h1>
    <p>Radique una contingencia con datos estructurados, paso a paso.</p>
</div>

<div class="fmt-card">
    <div class="nc-progreso">
        @for (var i = 0; i < TitulosPaso.Length; i++)
        {
            var numero = i + 1;
            <div class="nc-progreso-paso @(numero == pasoActual ? "activo" : "") @(numero < pasoActual ? "completado" : "")">
                <span class="nc-progreso-numero">@numero</span>
                <span class="nc-progreso-titulo">@TitulosPaso[i]</span>
            </div>
        }
    </div>
</div>

<div class="fmt-card" style="margin-top:1.25rem">
    @if (mensaje is not null)
    {
        <p class="fmt-ayuda" style="color:#c0392b">@mensaje</p>
    }

    <div class="nc-paso-encabezado">
        <h2>@pasoActual. @TitulosPaso[pasoActual - 1]</h2>
        <span class="nc-paso-badge">PASO @pasoActual/@TitulosPaso.Length</span>
    </div>

    @if (pasoActual <= 9)
    {
        <div class="nc-dictado">
            <div class="nc-dictado-encabezado">
                <div>
                    <strong><i class="fa-solid @(dictando ? "fa-microphone-lines" : "fa-microphone-slash")"></i> Dictado por voz — @TitulosPaso[pasoActual - 1]</strong>
                    <p class="fmt-ayuda">Pulsa Dictar y menciona el nombre del campo antes del dato.</p>
                </div>
                <div class="nc-dictado-botones">
                    <button type="button" class="fmt-btn" disabled="@(dictadoSoportadoVerificado && !dictadoSoportado)" @onclick="AlternarDictadoAsync">
                        <i class="fa-solid fa-microphone"></i> @(dictando ? "Detener" : "Dictar")
                    </button>
                    <button type="button" class="fmt-btn-secundario" disabled="@(string.IsNullOrWhiteSpace(transcripcionDictado))" @onclick="CargarCampos">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Cargar campos
                    </button>
                    <button type="button" class="fmt-icono-btn" title="Borrar" @onclick="LimpiarDictado">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </div>

            @if (dictadoSoportadoVerificado && !dictadoSoportado)
            {
                <p class="fmt-ayuda" style="color:#c0392b">Dictado por voz no disponible en este navegador. Usa Chrome o Edge.</p>
            }
            else if (errorDictado is not null)
            {
                <p class="fmt-ayuda" style="color:#c0392b">@errorDictado</p>
            }

            @if (dictando || !string.IsNullOrWhiteSpace(transcripcionDictado))
            {
                <textarea class="fmt-textarea nc-dictado-transcripcion" @bind="transcripcionDictado" @bind:event="oninput"
                          placeholder="El texto reconocido aparecerá aquí..."></textarea>
            }

            @if (mensajeDictado is not null)
            {
                <p class="fmt-ayuda">@mensajeDictado</p>
            }

            <p class="fmt-ayuda nc-dictado-ejemplo"><strong>Ejemplo:</strong> "@EjemploDictadoPasoActual()"</p>
        </div>
    }

    @if (pasoActual == 1)
    {
        <div class="fmt-row">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Causal de contingencia *</label>
                <div class="nc-causal-fila">
                    <select class="fmt-select" @bind="form.Causal">
                        <option value="">Selecciona la causal</option>
                        @foreach (var c in parametricas["CAUSAL"])
                        {
                            <option value="@c.Codigo">@c.Valor</option>
                        }
                    </select>
                    <button type="button" class="fmt-btn-secundario nc-causal-crear" @onclick="AbrirModalCausal">
                        <i class="fa-solid fa-plus"></i> Crear
                    </button>
                </div>
            </div>
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Descripción de la contingencia *</label>
                <textarea class="fmt-textarea" maxlength="500" @bind="form.CausalDescripcion" @bind:event="oninput"
                          placeholder="Describe brevemente las circunstancias que generaron la contingencia..."></textarea>
                <p class="fmt-ayuda" style="text-align:right">@form.CausalDescripcion.Length/500</p>
            </div>
        </div>
    }
    else if (pasoActual == 2)
    {
        <div class="fmt-row">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Código de Habilitación - IPS</label>
                <input class="fmt-input" list="dl-ips" value="@form.IpsTexto" @oninput="OnIpsInputAsync" placeholder="@(parametrosCia.NitPrestadores is null ? "Ingresar" : "Escriba el código o el nombre de la sede")" />
                <datalist id="dl-ips">@foreach (var o in opcionesIps) { <option value="@($"{o.Codigo}|{o.Nombre}")"></option> }</datalist>
            </div>
        </div>

        @if (detalleIps is not null)
        {
            <div class="nc-info-panel">
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">NIT</span>
                    <span class="nc-info-valor">@(detalleIps.Nit ?? "—")</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Cód. Habilitación</span>
                    <span class="nc-info-valor">@detalleIps.Codigo</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Departamento</span>
                    <span class="nc-info-valor">@(detalleIps.Departamento ?? "—")</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Municipio</span>
                    <span class="nc-info-valor">@(detalleIps.Municipio ?? "—")</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Clase de prestador</span>
                    <span class="nc-info-valor">@(detalleIps.Clase ?? "—")</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Estado</span>
                    <span class="nc-info-valor">@(detalleIps.Habilitado ? "Habilitado" : "No habilitado")</span>
                </div>
            </div>
        }
    }
    else if (pasoActual == 3)
    {
        <div class="fmt-row">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Profesional tratante</label>
                <input class="fmt-input" list="dl-profesional" value="@form.ProfesionalTexto" @oninput="OnProfesionalInputAsync" placeholder="Documento o nombre" />
                <datalist id="dl-profesional">@foreach (var p in opcionesProfesional) { <option value="@($"{p.NoIdentificacion}|{p.NombreCompleto}|{p.Profesion}")"></option> }</datalist>
            </div>
        </div>

        @if (detalleProfesional is not null)
        {
            <div class="nc-info-panel">
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Documento</span>
                    <span class="nc-info-valor">@detalleProfesional.TipoDoc @detalleProfesional.NoIdentificacion</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Profesión</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(detalleProfesional.Profesion) ? "—" : detalleProfesional.Profesion)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Sede</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(detalleProfesional.Sede) ? "—" : detalleProfesional.Sede)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Servicio</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(detalleProfesional.Servicio) ? "—" : detalleProfesional.Servicio)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Correo</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(detalleProfesional.CorreoElectronico) ? "—" : detalleProfesional.CorreoElectronico)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Celular</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(detalleProfesional.Celular) ? "—" : detalleProfesional.Celular)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Estado</span>
                    <span class="nc-info-valor">@detalleProfesional.EstadoDesc</span>
                </div>
            </div>
        }
    }
    else if (pasoActual == 4)
    {
        <div class="fmt-row">
            <div class="fmt-campo">
                <label class="fmt-label">Tipo de documento</label>
                <select class="fmt-select" @bind="form.PacienteTipoDoc">
                    <option value="CC">Cédula de ciudadanía</option>
                    <option value="CE">Cédula de extranjería</option>
                    <option value="TI">Tarjeta de identidad</option>
                    <option value="RC">Registro civil</option>
                    <option value="NV">Certificado de nacido vivo</option>
                    <option value="MS">Menor sin Identificación</option>
                    <option value="AS">Adulto sin Identificación</option>
                    <option value="PA">Pasaporte</option>
                    <option value="CD">Carné diplomático</option>
                    <option value="PE">Permiso Especial de Permanencia</option>
                    <option value="PT">Permiso de Protección Temporal</option>
                    <option value="SC">Salvo conducto de permanencia</option>
                </select>
            </div>
            <div class="fmt-campo">
                <label class="fmt-label">Número de documento</label>
                <input class="fmt-input" @bind="form.PacienteNumDoc" @bind:event="oninput" />
            </div>
            @if (!AfiliadosManual)
            {
                <div class="fmt-campo nc-buscar-campo">
                    <button type="button" class="fmt-btn" disabled="@buscandoAfiliado" @onclick="BuscarAfiliadoAsync">
                        <i class="fa-solid fa-magnifying-glass"></i> @(buscandoAfiliado ? "Buscando..." : "Buscar")
                    </button>
                </div>
            }
        </div>

        @if (mensajeAfiliado is not null)
        {
            <p class="fmt-ayuda" style="color:#c0392b">@mensajeAfiliado</p>
        }

        @* Modo manual (CIA sin web service de afiliados, parámetro AFILIADOS_ORIGEN=MANUAL en
           DQS_MIP_CIA_PARAMETROS): el usuario digita los datos del paciente. *@
        @if (AfiliadosManual)
        {
            <div class="fmt-row" style="margin-top:1rem">
                <div class="fmt-campo">
                    <label class="fmt-label">Nombres *</label>
                    <input class="fmt-input" maxlength="100" @bind="form.PacienteNombres" @bind:event="oninput" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Apellidos *</label>
                    <input class="fmt-input" maxlength="100" @bind="form.PacienteApellidos" @bind:event="oninput" />
                </div>
            </div>
            <div class="fmt-row" style="margin-top:1rem">
                <div class="fmt-campo">
                    <label class="fmt-label">Sexo *</label>
                    <select class="fmt-select" @bind="form.PacienteSexo">
                        <option value="">Seleccionar</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Fecha de nacimiento *</label>
                    <input type="date" class="fmt-input" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@form.PacienteFechaNacimiento" @onchange="e => form.PacienteFechaNacimiento = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Régimen</label>
                    <select class="fmt-select" @bind="form.PacienteRegimen">
                        <option value="">Seleccionar</option>
                        <option value="Contributivo">Contributivo</option>
                        <option value="Subsidiado">Subsidiado</option>
                        <option value="Especial">Especial</option>
                        <option value="Excepción">Excepción</option>
                        <option value="Particular">Particular</option>
                    </select>
                </div>
            </div>
            <div class="fmt-row" style="margin-top:1rem">
                <div class="fmt-campo">
                    <label class="fmt-label">Municipio</label>
                    <input class="fmt-input" maxlength="100" @bind="form.PacienteMunicipio" @bind:event="oninput" placeholder="Ej. Bogotá, Cundinamarca" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Teléfono</label>
                    <input class="fmt-input" maxlength="20" inputmode="tel" @bind="form.PacienteTelefono" @bind:event="oninput" />
                </div>
            </div>
        }

        @if (!AfiliadosManual && afiliadoEncontrado)
        {
            <div class="nc-info-panel">
                <div class="nc-info-item nc-info-item-ancho">
                    <span class="nc-info-etiqueta">Paciente</span>
                    <span class="nc-info-valor">@form.PacienteNombres @form.PacienteApellidos</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(parametrosCia.EntidadAfiliados))
                {
                    <div class="nc-info-item">
                        <span class="nc-info-etiqueta">EPS</span>
                        <span class="nc-info-valor">@parametrosCia.EntidadAfiliados</span>
                    </div>
                }
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Régimen</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(form.PacienteRegimen) ? "—" : form.PacienteRegimen)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Sexo</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(form.PacienteSexo) ? "—" : form.PacienteSexo)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Nacimiento</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(form.PacienteFechaNacimiento) ? "—" : form.PacienteFechaNacimiento)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Municipio</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(form.PacienteMunicipio) ? "—" : form.PacienteMunicipio)</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Teléfono</span>
                    <span class="nc-info-valor">@(string.IsNullOrEmpty(form.PacienteTelefono) ? "—" : form.PacienteTelefono)</span>
                </div>
            </div>
        }

        @if (AfiliadosManual || afiliadoEncontrado)
        {
            <div class="fmt-row" style="margin-top:1.25rem">
                <div class="fmt-campo">
                    <label class="fmt-label">Fecha de atención *</label>
                    <input type="date" class="fmt-input" value="@form.FechaAtencion" @onchange="e => form.FechaAtencion = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Hora *</label>
                    <input type="time" class="fmt-input" value="@form.HoraAtencion" @onchange="e => form.HoraAtencion = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="fmt-campo fmt-campo-ancho">
                    <label class="fmt-label">Ámbito de atención (MIPRES) *</label>
                    <select class="fmt-select" @bind="form.AmbitoAtencionCodigo">
                        <option value="">Seleccionar</option>
                        @foreach (var a in ambitosAtencion)
                        {
                            <option value="@a.Codigo">@a.Codigo @a.Descripcion</option>
                        }
                    </select>
                </div>
            </div>
        }
    }
    else if (pasoActual == 5)
    {
        <div class="fmt-row">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Diagnóstico (CIE-10)</label>
                <input class="fmt-input" list="dl-cie10" value="@form.DiagnosticoTexto" @oninput="OnDiagnosticoInputAsync" placeholder="Código o descripción" />
                <datalist id="dl-cie10">@foreach (var d in opcionesCie10) { <option value="@($"{d.Codigo}|{d.Descripcion}")"></option> }</datalist>
            </div>
        </div>

        @if (detalleDiagnostico is not null)
        {
            <div class="nc-info-panel">
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Código CIE-10</span>
                    <span class="nc-info-valor">@detalleDiagnostico.Codigo</span>
                </div>
                <div class="nc-info-item">
                    <span class="nc-info-etiqueta">Aplica a</span>
                    <span class="nc-info-valor">@InterpretarMarcaCie10(detalleDiagnostico.Marca)</span>
                </div>
                <div class="nc-info-item nc-info-item-ancho">
                    <span class="nc-info-etiqueta">Descripción</span>
                    <span class="nc-info-valor">@detalleDiagnostico.Descripcion</span>
                </div>
            </div>
        }

        <div class="fmt-row" style="margin-top:1.25rem">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Diagnóstico relacionado 1</label>
                <input class="fmt-input" list="dl-cie10-rel1" value="@form.DiagnosticoRel1Texto" @oninput="OnDiagnosticoRel1InputAsync" placeholder="Código o descripción (opcional)" />
                <datalist id="dl-cie10-rel1">@foreach (var d in opcionesCie10Rel1) { <option value="@($"{d.Codigo}|{d.Descripcion}")"></option> }</datalist>
            </div>
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Diagnóstico relacionado 2</label>
                <input class="fmt-input" list="dl-cie10-rel2" value="@form.DiagnosticoRel2Texto" @oninput="OnDiagnosticoRel2InputAsync" placeholder="Código o descripción (opcional)" />
                <datalist id="dl-cie10-rel2">@foreach (var d in opcionesCie10Rel2) { <option value="@($"{d.Codigo}|{d.Descripcion}")"></option> }</datalist>
            </div>
        </div>
    }
    else if (pasoActual == 6)
    {
        @if (tecnologiasAgregadas.Count > 0)
        {
            <div class="nc-tec-agregadas">
                <p class="fmt-ayuda"><strong>Tecnologías ya agregadas:</strong></p>
                @for (var i = 0; i < tecnologiasAgregadas.Count; i++)
                {
                    var indice = i;
                    var t = tecnologiasAgregadas[i];
                    <p class="fmt-ayuda">
                        @(i + 1). <strong>@t.TipoTecnologia</strong> — @ResumenTecnologia.Detalle(t)
                        <button type="button" class="fmt-btn-secundario" @onclick="() => QuitarTecnologia(indice)">Quitar</button>
                    </p>
                }
                <p class="fmt-ayuda">Elija el tipo de la siguiente tecnología:</p>
            </div>
        }
        <div class="nc-tec-grid">
            @foreach (var t in TiposTecnologia)
            {
                <div class="nc-tec-tarjeta @(form.TipoTecnologia == t.Valor ? "seleccionada" : "")" @onclick="() => SeleccionarTipoTecnologia(t.Valor)">
                    <strong>@t.Titulo</strong>
                    <p>@t.Descripcion</p>
                </div>
            }
        </div>
    }
    else if (pasoActual == 7)
    {
        <div class="fmt-row">
            @if (form.TipoTecnologia == "Medicamento")
            {
                <div class="fmt-campo">
                    <label class="fmt-label">Principio activo / DCI *</label>
                    <input class="fmt-input" list="dl-dci" value="@form.TecPrincipioActivo" @oninput="OnPrincipioActivoInputAsync" placeholder="Buscar denominación común internacional" />
                    <datalist id="dl-dci">@foreach (var d in opcionesDci) { <option value="@d"></option> }</datalist>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Concentración *</label>
                    <input class="fmt-input" @bind="form.TecDosis" @bind:event="oninput" placeholder="Ej. 50 mg" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Forma farmacéutica (MIPRES) *</label>
                    <select class="fmt-select" @bind="form.TecFormaFarmaceutica">
                        <option value="">Selecciona forma</option>
                        @foreach (var f in formasFarmaceuticas) { <option value="@f.Descripcion">@f.Descripcion</option> }
                    </select>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Vía de administración (MIPRES) *</label>
                    <select class="fmt-select" @bind="form.TecViaAdministracion">
                        <option value="">Selecciona vía</option>
                        @foreach (var v in viasAdministracion) { <option value="@v.Descripcion">@v.Descripcion</option> }
                    </select>
                </div>
            }
            else if (form.TipoTecnologia is "Procedimiento" or "Dispositivo" or "ProductoNutricional" or "ServicioComplementario")
            {
                <div class="fmt-campo fmt-campo-ancho">
                    <label class="fmt-label">@EtiquetaCodigoTecnologia()</label>
                    <input class="fmt-input" list="dl-codigos-tec" value="@form.TecBusquedaTexto" @oninput="OnTecBusquedaInputAsync" placeholder="Código o descripción" />
                    <datalist id="dl-codigos-tec">@foreach (var c in opcionesCodigosTecnologia) { <option value="@($"{c.Codigo}|{c.Descripcion}")"></option> }</datalist>
                </div>

                @if (detalleCodigoTecnologia is not null)
                {
                    <div class="nc-info-panel">
                        <div class="nc-info-item">
                            <span class="nc-info-etiqueta">Código</span>
                            <span class="nc-info-valor">@detalleCodigoTecnologia.Codigo</span>
                        </div>
                        <div class="nc-info-item nc-info-item-ancho">
                            <span class="nc-info-etiqueta">Descripción</span>
                            <span class="nc-info-valor">@detalleCodigoTecnologia.Descripcion</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="fmt-vacio">Seleccione primero el tipo de tecnología en el paso anterior.</p>
            }
        </div>
    }
    else if (pasoActual == 8)
    {
        @if (form.TipoTecnologia == "Medicamento")
        {
            <div class="fmt-row">
                <div class="fmt-campo">
                    <label class="fmt-label">Dosis *</label>
                    <input class="fmt-input" @bind="form.PosCantidadFormulada" @bind:event="oninput" placeholder="Cantidad (ej. 500)" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">&nbsp;</label>
                    <select class="fmt-select" @bind="form.PosCantidadFormuladaUnidad">
                        <option value="">Unidad</option>
                        @foreach (var u in unidadesDosis) { <option value="@u.Descripcion">@u.Descripcion</option> }
                    </select>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Frecuencia * (MIPRES)</label>
                    <input class="fmt-input" @bind="form.PosCadaFrecuencia" @bind:event="oninput" placeholder="Ej. 8" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">&nbsp;</label>
                    <select class="fmt-select" @bind="form.PosFrecuencia">
                        <option value="">Seleccionar</option>
                        @foreach (var u in unidadesFrecuencia) { <option value="@u.Descripcion">@u.Descripcion</option> }
                    </select>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Cantidad total *</label>
                    <input class="fmt-input" @bind="form.PosCantidadTotal" @bind:event="oninput" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Duración (número)</label>
                    <input class="fmt-input" @bind="form.PosDuracionTratamiento" @bind:event="oninput" placeholder="Ej. 5" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Unidad de tiempo (MIPRES)</label>
                    <select class="fmt-select" @bind="form.PosDuracionUnidad">
                        <option value="">Seleccionar</option>
                        @foreach (var u in unidadesFrecuencia) { <option value="@u.Descripcion">@u.Descripcion</option> }
                    </select>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Indicación especial (MIPRES)</label>
                    <select class="fmt-select" @bind="form.PosIndicacionEspecial">
                        <option value="">Seleccionar</option>
                        @foreach (var v in CatalogosPosologia.IndicacionEspecial) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div class="fmt-campo fmt-campo-ancho">
                    <label class="fmt-label">Indicaciones adicionales</label>
                    <textarea class="fmt-textarea" rows="3" @bind="form.PosIndicacionesAdicionales" @bind:event="oninput" placeholder="Notas adicionales (opcional)"></textarea>
                </div>
            </div>
        }
        else
        {
            <div class="fmt-row">
                <div class="fmt-campo">
                    <label class="fmt-label">Cantidad total *</label>
                    <input class="fmt-input" @bind="form.PosCantidadTotal" @bind:event="oninput" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Duración (número)</label>
                    <input class="fmt-input" @bind="form.PosDuracionTratamiento" @bind:event="oninput" placeholder="Ej. 5" />
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Unidad de tiempo (MIPRES)</label>
                    <select class="fmt-select" @bind="form.PosDuracionUnidad">
                        <option value="">Seleccionar</option>
                        @foreach (var v in CatalogosPosologia.DuracionUnidad) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div class="fmt-campo">
                    <label class="fmt-label">Indicación especial (MIPRES)</label>
                    <select class="fmt-select" @bind="form.PosIndicacionEspecial">
                        <option value="">Opcional — selecciona indicación</option>
                        @foreach (var v in CatalogosPosologia.IndicacionEspecial) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div class="fmt-campo fmt-campo-ancho">
                    <label class="fmt-label">Indicaciones adicionales</label>
                    <textarea class="fmt-textarea" rows="3" @bind="form.PosIndicacionesAdicionales" @bind:event="oninput" placeholder="Notas adicionales (opcional)"></textarea>
                </div>
            </div>
        }
    }
    else if (pasoActual == 9)
    {
        <div class="fmt-row">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Justificación técnica</label>
                <textarea class="fmt-textarea" style="min-height:8rem" @bind="form.JustificacionTecnica" @bind:event="oninput"></textarea>
            </div>
        </div>
        <div class="fmt-acciones">
            <button type="button" class="fmt-btn-secundario" @onclick="AgregarOtraTecnologiaAsync">+ Agregar otra tecnología</button>
        </div>
    }
    else if (pasoActual == 10)
    {
        <div class="fmt-row">
            <div class="fmt-campo fmt-campo-ancho">
                <label class="fmt-label">Soportes (.pdf, .png, .jpg, .jpeg, .tiff, .docx, .doc, .xlsx)</label>
                <div class="fmt-file">
                    <InputFile OnChange="OnSoportesSeleccionadosAsync" multiple accept=".pdf,.png,.jpg,.jpeg,.tiff,.docx,.doc,.xlsx" />
                </div>
                @if (soportes.Count > 0)
                {
                    <p class="fmt-ayuda">@soportes.Count archivo(s) seleccionado(s): @string.Join(", ", soportes.Select(s => s.NombreOriginal))</p>
                }
            </div>

            <div class="fmt-campo-ancho">
                <label class="fmt-label">Firma</label>
                <div class="nc-firma-tabs">
                    <button type="button" class="@(modoFirma == "dibujo" ? "fmt-btn" : "fmt-btn-secundario")" @onclick="CambiarADibujoAsync">Dibujar</button>
                    <button type="button" class="@(modoFirma == "archivo" ? "fmt-btn" : "fmt-btn-secundario")" @onclick="CambiarAArchivoAsync">Subir archivo</button>
                </div>

                @if (modoFirma == "dibujo")
                {
                    <div class="nc-firma-canvas-wrap">
                        <canvas id="nc-canvas-firma" width="400" height="150"></canvas>
                    </div>
                    <div class="fmt-acciones">
                        <button type="button" class="fmt-btn-secundario" @onclick="LimpiarDibujoAsync">Limpiar</button>
                        <button type="button" class="fmt-btn-secundario" @onclick="GuardarDibujoAsync">Usar este dibujo</button>
                    </div>
                }
                else
                {
                    <InputFile class="fmt-file" OnChange="OnArchivoFirmaSeleccionadoAsync" accept=".jpg,.jpeg,.png,.bmp,.gif" />
                }

                @if (firmaDataUrl is not null)
                {
                    <p class="fmt-ayuda">Firma actual:</p>
                    <img src="@firmaDataUrl" alt="Firma" class="nc-firma-preview" />
                }

                <p class="fmt-ayuda" style="color:#b7791f">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Firma capturada localmente — integración con proveedor de firma electrónica avanzada (FEA) pendiente.
                </p>
            </div>
        </div>
    }
    else if (pasoActual == 11)
    {
        <div class="nc-revision">
            <p><strong>Causal:</strong> @NombreCausalSeleccionada()</p>
            <p><strong>Descripción:</strong> @form.CausalDescripcion</p>
            <p><strong>IPS:</strong> @TextoLegible(form.IpsTexto)</p>
            <p><strong>Profesional tratante:</strong> @ProfesionalLegible()</p>
            <p><strong>Paciente:</strong> @form.PacienteTipoDoc @form.PacienteNumDoc — @form.PacienteNombres @form.PacienteApellidos</p>
            <p><strong>Atención:</strong> @form.FechaAtencion @form.HoraAtencion — @ambitosAtencion.FirstOrDefault(a => a.Codigo == form.AmbitoAtencionCodigo).Descripcion</p>
            <p><strong>Diagnóstico:</strong> @TextoLegible(form.DiagnosticoTexto)</p>
            @if (!string.IsNullOrWhiteSpace(form.DiagnosticoRel1Texto))
            {
                <p><strong>Diagnóstico relacionado 1:</strong> @TextoLegible(form.DiagnosticoRel1Texto)</p>
            }
            @if (!string.IsNullOrWhiteSpace(form.DiagnosticoRel2Texto))
            {
                <p><strong>Diagnóstico relacionado 2:</strong> @TextoLegible(form.DiagnosticoRel2Texto)</p>
            }
            @{ var todas = TodasLasTecnologias(); }
            @for (var i = 0; i < todas.Count; i++)
            {
                var indice = i;
                var t = todas[i];
                <div class="nc-revision-tecnologia">
                    <p><strong>Tecnología @(i + 1) (@t.TipoTecnologia):</strong> @ResumenTecnologia.Detalle(t)
                        @if (i < tecnologiasAgregadas.Count)
                        {
                            <button type="button" class="fmt-btn-secundario" @onclick="() => QuitarTecnologia(indice)">Quitar</button>
                        }
                    </p>
                    <p><strong>Posología:</strong> @ResumenTecnologia.Posologia(t)</p>
                    @if (!string.IsNullOrWhiteSpace(t.PosIndicacionesAdicionales))
                    {
                        <p><strong>Indicaciones adicionales:</strong> @t.PosIndicacionesAdicionales</p>
                    }
                    <p><strong>Justificación técnica:</strong> @t.JustificacionTecnica</p>
                </div>
            }
            <div class="fmt-acciones">
                <button type="button" class="fmt-btn-secundario" @onclick="AgregarOtraTecnologiaAsync">+ Agregar otra tecnología</button>
            </div>
            <p><strong>Soportes:</strong> @(soportes.Count == 0 ? "Ninguno" : string.Join(", ", soportes.Select(s => s.NombreOriginal)))</p>
            <p><strong>Firma:</strong> @(firmaDataUrl is not null ? "Capturada" : "Sin capturar")</p>
            <p class="fmt-ayuda" style="color:#b7791f">
                <i class="fa-solid fa-triangle-exclamation"></i>
                Al confirmar, la firma queda marcada como pendiente de integración con un proveedor de FEA real.
            </p>
        </div>
    }

    <div class="fmt-acciones">
        <button type="button" class="fmt-btn-secundario" disabled="@(pasoActual == 1)" @onclick="PasoAnterior">Anterior</button>
        @if (pasoActual < TitulosPaso.Length)
        {
            <button type="button" class="fmt-btn" @onclick="PasoSiguienteAsync">Siguiente</button>
        }
        else
        {
            <button type="button" class="fmt-btn" disabled="@enviando" @onclick="ConfirmarAsync">@(enviando ? "Registrando..." : "Confirmar y registrar")</button>
        }
    </div>
</div>

@if (mostrarModalCausal)
{
    <div class="fmt-modal-fondo" @onclick="CerrarModalCausal">
        <div class="fmt-modal" @onclick:stopPropagation="true">
            <div class="fmt-modal-encabezado">
                <h3>Nueva causal</h3>
                <button type="button" class="fmt-modal-cerrar" @onclick="CerrarModalCausal">&times;</button>
            </div>
            <div class="fmt-modal-cuerpo">
                @if (mensajeModalCausal is not null)
                {
                    <p class="fmt-ayuda" style="color:#c0392b">@mensajeModalCausal</p>
                }
                <div class="fmt-campo fmt-campo-ancho">
                    <label class="fmt-label">Nombre de la causal</label>
                    <input class="fmt-input" @bind="nuevaCausalTexto" @bind:event="oninput" placeholder="Ej. Falla eléctrica del generador" />
                </div>
            </div>
            <div class="fmt-modal-acciones fmt-acciones">
                <button type="button" class="fmt-btn" disabled="@guardandoCausal" @onclick="GuardarNuevaCausalAsync">@(guardandoCausal ? "Guardando..." : "Guardar")</button>
                <button type="button" class="fmt-btn-secundario" @onclick="CerrarModalCausal">Cancelar</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] TitulosPaso =
        ["Causal", "IPS", "Profesional", "Paciente", "Diagnóstico", "Tipo tecnología",
         "Detalle tecnología", "Posología", "Justificación", "Soportes y firma", "Revisión"];

    private static readonly string[] ExtensionesSoportesPermitidas =
        [".png", ".jpg", ".jpeg", ".tiff", ".docx", ".doc", ".xlsx", ".pdf"];

    private int pasoActual = 1;
    private string? mensaje;
    private bool enviando;

    private FormularioNuevaContingencia form = new();
    private ILookup<string, ParametricaValor> parametricas = Enumerable.Empty<ParametricaValor>().ToLookup(_ => "");

    private IReadOnlyList<PrestadorHabilitacion> opcionesIps = [];
    private DetallePrestador? detalleIps;
    private ProfesionalMip? detalleProfesional;
    private Cie10Fila? detalleDiagnostico;
    private Cie10Fila? detalleDiagnosticoRel1;
    private Cie10Fila? detalleDiagnosticoRel2;
    private List<(string Codigo, string Descripcion)> ambitosAtencion = [];
    // Parámetros de la CIA de la sesión (DQS_MIP_CIA_PARAMETROS): decide si el paso 4 consulta el
    // web service de afiliados o muestra el formulario manual. Sin parámetro => manual.
    private ParametrosCia parametrosCia = new(OrigenAfiliados.Manual, null);
    private bool AfiliadosManual => parametrosCia.OrigenAfiliados == OrigenAfiliados.Manual;
    private bool buscandoAfiliado;
    private bool afiliadoEncontrado;
    private string? mensajeAfiliado;
    private static readonly (string Valor, string Titulo, string Descripcion)[] TiposTecnologia =
    [
        ("Medicamento", "Medicamento", "DCI, concentración, vía, dosis, frecuencia y duración."),
        ("Procedimiento", "Procedimiento", "Código CUPS, cantidad, frecuencia y justificación."),
        ("Dispositivo", "Dispositivo médico", "Código del dispositivo, cantidad e indicaciones."),
        ("ProductoNutricional", "Producto nutricional", "Producto, presentación y justificación nutricional."),
        ("ServicioComplementario", "Servicio complementario", "Servicio, frecuencia, duración y justificación."),
    ];

    private List<ProfesionalMip> opcionesProfesional = [];
    private IReadOnlyList<Cie10Fila> opcionesCie10 = [];
    private IReadOnlyList<Cie10Fila> opcionesCie10Rel1 = [];
    private IReadOnlyList<Cie10Fila> opcionesCie10Rel2 = [];
    private IReadOnlyList<CodigoFila> opcionesCodigosTecnologia = [];
    private CodigoFila? detalleCodigoTecnologia;
    private List<(string Codigo, string Descripcion)> formasFarmaceuticas = [];
    private List<(string Codigo, string Descripcion)> viasAdministracion = [];
    private List<(string Codigo, string Descripcion)> unidadesDosis = [];
    private List<(string Codigo, string Descripcion)> unidadesFrecuencia = [];
    private IReadOnlyList<string> opcionesDci = [];
    private bool principioActivoValido;

    private readonly List<(string NombreOriginal, byte[] Contenido)> soportes = [];
    private string modoFirma = "dibujo";
    private string? firmaDataUrl;
    private byte[]? firmaArchivoBytes;
    private string? firmaArchivoExtension;

    // ---- Dictado por voz (Web Speech API, ver wwwroot/js/dictado-voz.js) ----
    private bool dictadoSoportado = true;
    private bool dictadoSoportadoVerificado;
    private bool dictando;
    private string transcripcionDictado = "";
    private string? errorDictado;
    private string? mensajeDictado;
    private DotNetObjectReference<NuevaContingencia>? dictadoRef;

    // ---- Modal "Nueva causal" (paso 1) ----
    private bool mostrarModalCausal;
    private string nuevaCausalTexto = "";
    private string? mensajeModalCausal;
    private bool guardandoCausal;

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? EstadoAutenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        parametricas = await ParametricasService.CargarAsync();

        var (cia, _) = await ObtenerUsuarioAsync();
        parametrosCia = await CiaParametrosService.ObtenerAsync(cia);
        var dtCruzar = await FiltrosRepository.ConsultarAsync(cia, 138);
        ambitosAtencion = dtCruzar.AsEnumerable()
            .Where(f => string.Equals(Convert.ToString(f["CAMPO"]), "CodAmbAte", StringComparison.OrdinalIgnoreCase))
            .Select(f => (Codigo: Convert.ToString(f["CODIGO"]) ?? "", Descripcion: Convert.ToString(f["DESCRIPCION"]) ?? ""))
            .DistinctBy(a => a.Codigo)
            .OrderBy(a => a.Codigo)
            .ToList();

        // Paso 7 (Medicamento) — Forma farmacéutica y Vía de administración (MIPRES) vienen
        // del mismo DataTable de DQS_MIP_CRUZAR ya cargado arriba (CAMPO='CodFF'/'CodVA'),
        // sin otra consulta.
        formasFarmaceuticas = dtCruzar.AsEnumerable()
            .Where(f => string.Equals(Convert.ToString(f["CAMPO"]), "CodFF", StringComparison.OrdinalIgnoreCase))
            .Select(f => (Codigo: Convert.ToString(f["CODIGO"]) ?? "", Descripcion: Convert.ToString(f["DESCRIPCION"]) ?? ""))
            .DistinctBy(a => a.Descripcion)
            .OrderBy(a => a.Descripcion)
            .ToList();
        viasAdministracion = dtCruzar.AsEnumerable()
            .Where(f => string.Equals(Convert.ToString(f["CAMPO"]), "CodVA", StringComparison.OrdinalIgnoreCase))
            .Select(f => (Codigo: Convert.ToString(f["CODIGO"]) ?? "", Descripcion: Convert.ToString(f["DESCRIPCION"]) ?? ""))
            .DistinctBy(a => a.Descripcion)
            .OrderBy(a => a.Descripcion)
            .ToList();

        // Paso 8 (Posología, Medicamento) — Unidad de la dosis (CAMPO='DosisUM', ej. mg, ml,
        // UI) y Unidad de tiempo/frecuencia (CAMPO='CODFREADMON', 8 valores MIPRES: Minuto(s)
        // .. Única), también del mismo DataTable ya cargado arriba.
        unidadesDosis = dtCruzar.AsEnumerable()
            .Where(f => string.Equals(Convert.ToString(f["CAMPO"]), "DosisUM", StringComparison.OrdinalIgnoreCase))
            .Select(f => (Codigo: Convert.ToString(f["CODIGO"]) ?? "", Descripcion: Convert.ToString(f["DESCRIPCION"]) ?? ""))
            .DistinctBy(a => a.Descripcion)
            .OrderBy(a => a.Descripcion)
            .ToList();
        unidadesFrecuencia = dtCruzar.AsEnumerable()
            .Where(f => string.Equals(Convert.ToString(f["CAMPO"]), "CODFREADMON", StringComparison.OrdinalIgnoreCase))
            .Select(f => (Codigo: Convert.ToString(f["CODIGO"]) ?? "", Descripcion: Convert.ToString(f["DESCRIPCION"]) ?? ""))
            .OrderBy(a => int.TryParse(a.Codigo, out var n) ? n : int.MaxValue)
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dictadoSoportado = await JS.InvokeAsync<bool>("ImperiumDictado.soportado");
            dictadoSoportadoVerificado = true;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (dictadoRef is not null)
        {
            _ = JS.InvokeVoidAsync("ImperiumDictado.detener");
            dictadoRef.Dispose();
        }
    }

    private async Task<(string cia, string usuApp)> ObtenerUsuarioAsync()
    {
        var estado = EstadoAutenticacion is not null ? await EstadoAutenticacion : null;
        var usuario = estado?.User;
        return (usuario?.Cia() ?? "", usuario?.UsuApp() ?? "");
    }

    // ---- Varias tecnologías por contingencia ----
    // Los pasos 6 a 9 (tipo, detalle, posología, justificación) se repiten por tecnología. Las
    // ya cerradas viven en esta lista; la que se está capturando vive en `form` (Tec*/Pos*/
    // TipoTecnologia/JustificacionTecnica) y es siempre la última al confirmar.
    private readonly List<TecnologiaContingencia> tecnologiasAgregadas = [];

    private TecnologiaContingencia ConstruirTecnologiaActual() => new(
        form.TipoTecnologia,
        NuloSiVacio(form.TecNombre), NuloSiVacio(form.TecCodigo), NuloSiVacio(form.TecPrincipioActivo), NuloSiVacio(form.TecFormaFarmaceutica),
        NuloSiVacio(form.TecViaAdministracion), NuloSiVacio(form.TecDosis),
        NuloSiVacio(form.PosTipoPrestacion), NuloSiVacio(form.PosCantidadFormulada), NuloSiVacio(form.PosCantidadFormuladaUnidad), NuloSiVacio(form.PosCadaFrecuencia),
        NuloSiVacio(form.PosFrecuencia), NuloSiVacio(form.PosDuracionTratamiento), NuloSiVacio(form.PosDuracionUnidad),
        NuloSiVacio(form.PosIndicacionEspecial), NuloSiVacio(form.PosCantidadTotal), NuloSiVacio(form.PosIndicadorRecurrencia),
        NuloSiVacio(form.PosIndicacionesAdicionales),
        form.JustificacionTecnica.Trim());

    private List<TecnologiaContingencia> TodasLasTecnologias() => [.. tecnologiasAgregadas, ConstruirTecnologiaActual()];

    // "Agregar otra tecnología": cierra la que se está capturando (exige que los pasos 6 a 9
    // estén completos) y vuelve al paso 6 con todo en blanco.
    private async Task AgregarOtraTecnologiaAsync()
    {
        for (var paso = 6; paso <= 9; paso++)
        {
            var error = ValidarPaso(paso);
            if (error is not null)
            {
                mensaje = $"Complete la tecnología actual antes de agregar otra (paso {paso}): {error}";
                await JS.InvokeVoidAsync("Tran", mensaje, "");
                return;
            }
        }

        tecnologiasAgregadas.Add(ConstruirTecnologiaActual());
        form.TipoTecnologia = "";
        form.JustificacionTecnica = "";
        LimpiarCamposTecnologia();
        mensaje = null;
        await DetenerDictadoSiActivoAsync();
        LimpiarEstadoDictado();
        pasoActual = 6;
    }

    private void QuitarTecnologia(int indice)
    {
        if (indice >= 0 && indice < tecnologiasAgregadas.Count)
        {
            tecnologiasAgregadas.RemoveAt(indice);
        }
    }

    // Cambiar de tipo de tecnología invalida cualquier código/búsqueda ya elegido para el paso
    // 7 — sin este reseteo, si el usuario iba y volvía del paso 6, quedaba un código válido
    // de un TipoServicio distinto (ej. Procedimiento) pasando la validación del nuevo tipo
    // (ej. Producto Nutricional) sin haber buscado nada en el catálogo correcto.
    private void SeleccionarTipoTecnologia(string valor)
    {
        if (form.TipoTecnologia == valor) return;
        form.TipoTecnologia = valor;
        LimpiarCamposTecnologia();
    }

    // Deja en blanco los campos de detalle (paso 7) y posología (paso 8) de la tecnología que
    // se está capturando; el tipo (paso 6) y la justificación (paso 9) los maneja el llamador.
    private void LimpiarCamposTecnologia()
    {
        form.TecBusquedaTexto = "";
        form.TecCodigo = "";
        form.TecNombre = "";
        form.TecPrincipioActivo = "";
        form.TecFormaFarmaceutica = "";
        form.TecViaAdministracion = "";
        form.TecDosis = "";
        detalleCodigoTecnologia = null;
        opcionesCodigosTecnologia = [];
        opcionesDci = [];
        principioActivoValido = false;

        // El paso 8 (Posología) también cambia de forma según el tipo — el formulario
        // simplificado de Procedimiento/Dispositivo/Producto Nutricional/Servicio
        // complementario no comparte campos con el de Medicamento (que sigue pendiente de
        // redefinir aparte). Se limpia todo Posología al cambiar de tipo para no arrastrar
        // datos que ya no apliquen a la forma nueva.
        form.PosTipoPrestacion = "";
        form.PosCantidadFormulada = "";
        form.PosCantidadFormuladaUnidad = "";
        form.PosCadaFrecuencia = "";
        form.PosFrecuencia = "";
        form.PosDuracionTratamiento = "";
        form.PosDuracionUnidad = "";
        form.PosIndicacionEspecial = "";
        form.PosCantidadTotal = "";
        form.PosIndicadorRecurrencia = "";
        form.PosIndicacionesAdicionales = "";
    }

