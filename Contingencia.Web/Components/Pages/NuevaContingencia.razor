    private bool AsignarCausalPorVoz(string valorNormalizado)
    {
        var opcion = parametricas["CAUSAL"].FirstOrDefault(o =>
            Normalizar(o.Valor).Contains(valorNormalizado) || valorNormalizado.Contains(Normalizar(o.Valor)));
        if (opcion is null) return false;
        form.Causal = opcion.Codigo;
        return true;
    }

    private static readonly (string[] Frases, string Codigo)[] MapaTipoDocumento =
    [
        (["cedula de ciudadania", "cedula"], "CC"),
        (["cedula de extranjeria"], "CE"),
        (["tarjeta de identidad"], "TI"),
        (["registro civil"], "RC"),
        (["pasaporte"], "PA"),
        (["certificado de nacido vivo"], "NV"),
        (["menor sin identificacion"], "MS"),
        (["adulto sin identificacion"], "AS"),
    ];

    private bool AsignarTipoDocumentoPorVoz(string valor)
    {
        foreach (var (frases, codigo) in MapaTipoDocumento)
        {
            if (frases.Any(f => valor.Contains(f)))
            {
                form.PacienteTipoDoc = codigo;
                return true;
            }
        }
        return false;
    }

    private static Func<string, bool> AsignarSoloDigitos(Action<string> asignar) => valor =>
    {
        var digitos = new string(valor.Where(char.IsDigit).ToArray());
        if (digitos.Length == 0) return false;
        asignar(digitos);
        return true;
    };

    private static Func<string, bool> AsignarOpcion(IReadOnlyList<string> opciones, Action<string> asignar) => valor =>
    {
        var opcion = opciones.FirstOrDefault(o => Normalizar(o).Contains(valor) || valor.Contains(Normalizar(o)));
        if (opcion is null) return false;
        asignar(opcion);
        return true;
    };

    private static string LimitarTexto(string valor, int longitudMaxima) =>
        valor.Length > longitudMaxima ? valor[..longitudMaxima] : valor;

    // Quita tildes/diacríticos y pasa a minúsculas, para comparar sin importar acentuación
    // (el reconocimiento de voz no siempre transcribe tildes de forma consistente).
    private static string Normalizar(string texto)
    {
        var descompuesto = texto.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder();
        foreach (var caracter in descompuesto)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(caracter) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(caracter);
            }
        }
        return builder.ToString().Normalize(NormalizationForm.FormC).ToLowerInvariant().Trim();
    }

    private static string LimpiarValor(string valor)
    {
        var limpio = valor.Trim().Trim(':', ',', '-', '.').Trim();
        string[] conectores = ["es igual a ", "igual a ", "es "];
        foreach (var conector in conectores)
        {
            if (limpio.StartsWith(conector, StringComparison.Ordinal))
            {
                limpio = limpio[conector.Length..].Trim();
                break;
            }
        }
        return limpio;
    }

    // Parser "mejor esfuerzo": ubica en la transcripción, para cada campo del paso actual,
    // el sinónimo más largo que aparezca (evita que "documento" se coma la mención de
    // "número de documento"), y toma como valor el texto entre esa mención y la siguiente.
    // Nunca lanza excepción; lo que no se reconoce se deja para llenar a mano.
    private void CargarCampos()
    {
        var campos = CamposDictadoPasoActual();
        var aplicados = new List<string>();
        var noReconocidos = new List<string>();

        if (string.IsNullOrWhiteSpace(transcripcionDictado) || campos.Count == 0)
        {
            mensajeDictado = "No hay texto dictado para aplicar.";
            return;
        }

        var normalizado = Normalizar(transcripcionDictado);
        var menciones = new List<(int Inicio, int Longitud, CampoDictado Campo)>();

        foreach (var campo in campos)
        {
            foreach (var sinonimo in campo.Sinonimos.OrderByDescending(s => s.Length))
            {
                var indice = normalizado.IndexOf(sinonimo, StringComparison.Ordinal);
                if (indice >= 0)
                {
                    menciones.Add((indice, sinonimo.Length, campo));
                    break;
                }
            }
        }

        if (menciones.Count == 0)
        {
            mensajeDictado = "No se reconoció ningún campo en el texto dictado.";
            return;
        }

        menciones.Sort((a, b) => a.Inicio.CompareTo(b.Inicio));

        for (var i = 0; i < menciones.Count; i++)
        {
            var (inicio, longitud, campo) = menciones[i];
            var fin = i + 1 < menciones.Count ? menciones[i + 1].Inicio : normalizado.Length;
            var inicioValor = inicio + longitud;

            var crudo = inicioValor < fin && fin <= normalizado.Length ? normalizado[inicioValor..fin] : "";
            var valor = LimpiarValor(crudo);

            if (valor.Length == 0 || !campo.Asignar(valor))
            {
                noReconocidos.Add(campo.Etiqueta);
                continue;
            }

            aplicados.Add(campo.Etiqueta);
        }

        var mencionados = menciones.Select(m => m.Campo.Etiqueta).ToHashSet();
        noReconocidos.AddRange(campos.Where(c => !mencionados.Contains(c.Etiqueta)).Select(c => c.Etiqueta));

        mensajeDictado =
            (aplicados.Count > 0 ? $"Se completaron: {string.Join(", ", aplicados)}. " : "") +
            (noReconocidos.Count > 0 ? $"No se reconocieron: {string.Join(", ", noReconocidos)}." : "");

        if (mensajeDictado.Length == 0)
        {
            mensajeDictado = "No se aplicó ningún campo.";
        }
    }

