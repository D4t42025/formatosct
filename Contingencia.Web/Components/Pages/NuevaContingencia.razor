    private async Task BuscarAfiliadoAsync()
    {
        mensajeAfiliado = null;
        afiliadoEncontrado = false;

        if (string.IsNullOrWhiteSpace(form.PacienteTipoDoc) || string.IsNullOrWhiteSpace(form.PacienteNumDoc))
        {
            mensajeAfiliado = "Seleccione el tipo e ingrese el número de documento.";
            return;
        }

        buscandoAfiliado = true;
        try
        {
            var resultado = await AfiliadoService.ConsultarAsync(form.PacienteTipoDoc, form.PacienteNumDoc.Trim(), parametrosCia.UrlAfiliados);
            if (!resultado.Exito || resultado.Datos is null)
            {
                mensajeAfiliado = resultado.Mensaje ?? "No se encontró el afiliado.";
                return;
            }

            var d = resultado.Datos;
            form.PacienteNombres = d.Nombres;
            form.PacienteApellidos = d.Apellidos;
            form.PacienteSexo = d.Sexo;
            form.PacienteFechaNacimiento = d.FechaNacimiento ?? "";
            form.PacienteMunicipio = string.Join(", ", new[] { d.Municipio, d.Departamento }.Where(m => !string.IsNullOrWhiteSpace(m)));
            form.PacienteTelefono = d.Telefono ?? "";
            form.PacienteRegimen = d.Regimen ?? "";
            afiliadoEncontrado = true;
        }
        finally
        {
            buscandoAfiliado = false;
        }
    }

    private async Task PasoAnterior()
    {
