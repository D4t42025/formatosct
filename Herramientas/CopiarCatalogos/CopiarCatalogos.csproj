<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramienta de despliegue (no forma parte de la solución web): copia los catálogos, y opcionalmente tokens, usuarios e
       historial, de una base de datos origen (p. ej. DQUALITYREC) a la base nueva de producción, con SqlBulkCopy en streaming.
       Multiplataforma (Windows/Linux). Ver Contingencia.Infrastructure/BASE_DE_DATOS.md, "Paso 4". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CopiarCatalogos</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
