<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Contingencia.Domain\Contingencia.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Reemplaza a iTextSharp (solo .NET Framework) para portar la generación del PDF de
         "Acta de Juntas de Profesionales" de JuntaProfesional.aspx.vb — ver Juntas/ActaPdfBuilder.cs.
         itext7 por sí solo tira NotSupportedException al escribir (necesita un proveedor de
         criptografía para el serializador interno de PdfWriter, incluso sin cifrar el PDF) —
         confirmado en vivo al generar la primera acta de prueba. -->
    <PackageReference Include="itext7" Version="9.8.0" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="9.8.0" />
    <!-- itext7.bouncy-castle-adapter 8.0.5 trae BouncyCastle.Cryptography 2.2.1, con CVEs
         moderados conocidos (GHSA-8xfc-gm6g-vgpv, GHSA-m44j-cfrm-g8qc, GHSA-v435-xc8x-wvr9) —
         se fija una versión parcheada explícitamente. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Reemplaza a System.Drawing (Windows-only) para recortar/escalar la imagen de la
         firma en el acta — ver ActaPdfBuilder.CeldaFirma, réplica de FirmaActa.vb del
         legado. SkiaSharp es MIT (sin licencia comercial); trae el nativo de Windows/macOS y
         se agrega explícitamente el de Linux sin dependencias del sistema (no requiere
         fontconfig ni libs gráficas en el servidor). Antes se usaba SixLabors.ImageSharp, cuyas
         versiones sin vulnerabilidades (4.x) exigen licencia comercial. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- Versión mínima segura de una dependencia transitiva de Microsoft.Data.SqlClient (avisos GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7 en 9.0.13). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plantilla oficial MIPRES NoPBS (formulario de contingencia, 3 páginas). Va incrustada en el
         ensamblado (no como archivo suelto) para que la ruta y las mayúsculas no dependan del sistema de
         archivos (Windows/Linux) — ver Contingencias/FormularioPdf/FormularioContingenciaPdfBuilder.cs. -->
    <EmbeddedResource Include="Contingencias/FormularioPdf/formulario-contingencia-mipres.pdf" LogicalName="formulario-contingencia-mipres.pdf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
